APP_ENV=development
WEB_CONCURRENCY=1
ASGI_THREAD_TOKENS=16
GUNICORN_GRACEFUL_TIMEOUT=30
FORWARDED_ALLOW_IPS=*
ACE_DIR=/media
FILE_DIR=/tmp
COMPOSE_CONVERT_WINDOWS_PATHS=1
SHARED_PROXY_NETWORK=nginx-proxy
POSTGRES_HOST=store-pgsql17
CACHE_REDIS_URL=redis://store_redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
S3_PATH=neurostore-backup
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
AUTH0_API_AUDIENCE=localhost
COMPOSE_AUTH0_CLIENT_ID=COMPOSE_CLIENT_ID
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_GATEWAY=https://api.portkey.ai/v1
OPENAI_EMBEDDING_MODEL=@psyc-aid338-ope-333f18/text-embedding-3-small
V_HOST=localhost
DEBUG=True
EMAIL=your@email.com  # for queries to openalex
SEMANTIC_SCHOLAR_API_KEY=semantic_scholar_api_key
PUBMED_TOOL_API_KEY=pubmed_tool_api_key
# Logging. LOG_LEVEL is neurostore's own; ROOT_LOG_LEVEL is every library in
# the process, kept quieter so raising ours does not drown the output.
LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARNING
# Set ERROR_LOG_FILE to also write errors (ERROR and above) to disk; leave it
# empty to log to stderr only. docker-compose.yml overrides this per service,
# so the value here is the API's, and each service keeps its own file.
ERROR_LOG_FILE=/file-data/logs/neurostore-api-errors.log
# How that file is kept from growing forever. Rotating one shared file from
# several gunicorn workers loses records -- whichever worker rotates first
# renames the file the others are still appending to -- so the default adapts
# to WEB_CONCURRENCY rather than assuming one writer.
#
# auto:        per-process when WEB_CONCURRENCY is above 1, else size.
# size:        this process rotates the file at ERROR_LOG_MAX_BYTES. Only safe
#              while it is the sole writer; startup warns if it is not.
# per-process: as size, but each worker writes neurostore-api-errors.<pid>.log,
#              so the rotations never collide. Needs nothing outside
#              the app; grep the directory rather than one file.
# external:    one shared file, never rotated here and reopened when something
#              else renames it. Requires logrotate or a log collector, which
#              this deployment does not run today.
ERROR_LOG_ROTATION=auto
# Each writer keeps at most MAX_BYTES x (BACKUP_COUNT + 1) = 20M, so a
# four-worker API holds 80M of error logs at most.
ERROR_LOG_MAX_BYTES=5242880
ERROR_LOG_BACKUP_COUNT=3

# Error reporting. Leave SENTRY_DSN empty to keep Sentry off.
# One Sentry project per backend: this DSN must be the neurostore backend
# project, separate from the neurosynth-compose backend, from compose-runner
# and from the javascript-react frontend.
# Within this project the API and the outbox/release workers are told apart by
# SENTRY_COMPONENT, set per container in docker-compose.yml. It arrives as both
# a `component` tag and the `server_name` field, so in Sentry you can filter
# with component:neurostore-flag-outbox or server_name:neurostore-api.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
