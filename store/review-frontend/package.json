{
    "name": "neurostore-review",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:perf": "vitest run --mode perf",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "gen:types": "node scripts/gen-types.mjs",
        "check:types": "npm run gen:types && ! git status --porcelain src/contract/generated | grep ."
    },
    "dependencies": {
        "@auth0/auth0-react": "^2.21.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@handsontable/react-wrapper": "^18.1.2",
        "@mui/icons-material": "^5.18.0",
        "@mui/material": "^5.18.0",
        "@neurosynth/coordinate-table": "file:../../packages/coordinate-table",
        "@neurosynth/theme": "file:../../packages/neurosynth-theme",
        "@tanstack/react-query": "^5.102.8",
        "handsontable": "^18.1.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^6.30.3",
        "zustand": "^4.5.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.64.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "ajv": "^8.20.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "fake-indexeddb": "^6.2.6",
        "globals": "^15.15.0",
        "js-yaml": "^4.3.2",
        "jsdom": "^25.0.1",
        "json-schema-to-typescript": "^16.0.0",
        "prettier": "^3.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^6.4.5",
        "vitest": "^4.1.11"
    }
}
