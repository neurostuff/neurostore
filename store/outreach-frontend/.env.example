# Development: sign in with the backend's OUTREACH_DEV_PASSWORD instead of Auth0.
VITE_APP_OUTREACH_DEV_LOGIN=1
# Empty: call the API on this origin (the dev server proxies /api to OUTREACH_API_PROXY).
VITE_APP_NEUROSTORE_API_DOMAIN=
# Production: the main site's Auth0 SPA client, as for /review.
VITE_APP_AUTH0_DOMAIN=
VITE_APP_AUTH0_CLIENT_ID=
VITE_APP_AUTH0_AUDIENCE=
